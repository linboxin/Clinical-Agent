# Copy to .env and fill in. .env is gitignored.

# --- OpenAI (required for the planner) ---
OPENAI_API_KEY=
# Only set if you were given a non-default endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=
# Allowed: gpt-4o-mini, gpt-4o-2024-08-06, gpt-4.1-nano, gpt-4.1-mini, gpt-4.1,
#          gpt-5-mini, gpt-5, gpt-5.1, gpt-5.2, gpt-5.4-nano, gpt-5.4-mini, gpt-5.4
PLANNER_MODEL=gpt-5.4-mini
# Optional: low | medium | high (only for reasoning models; leave empty to use the model default)
PLANNER_REASONING_EFFORT=

# --- ClinicalTrials.gov ---
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_CACHE_DIR=.cache/ctgov
CTGOV_CACHE_TTL_SECONDS=86400
MAX_TRIALS_PER_COHORT=30000
# Client-side pacing: the API returns HTTP 429 on bursts but publishes no limit headers
CTGOV_REQUESTS_PER_MINUTE=40
CTGOV_BURST=5

# --- Service ---
RUN_DEADLINE_SECONDS=90
DATA_DIR=data
