  "description": "Envelope. `status` decides which of visualization / clarification / error is set:\n\nok \u2192 visualization; empty \u2192 visualization with no data; needs_clarification \u2192\nclarification; unsupported / failed \u2192 error.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "visualization": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "bar_chart": "#/$defs/BarChartSpec",
              "grouped_bar_chart": "#/$defs/GroupedBarChartSpec",
              "histogram": "#/$defs/HistogramSpec",
              "network_graph": "#/$defs/NetworkGraphSpec",
              "pie_chart": "#/$defs/PieChartSpec",
              "scatter_plot": "#/$defs/ScatterPlotSpec",
              "stacked_bar_chart": "#/$defs/StackedBarChartSpec",
              "time_series": "#/$defs/TimeSeriesSpec"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BarChartSpec"
            },
            {
              "$ref": "#/$defs/GroupedBarChartSpec"
            },
            {
              "$ref": "#/$defs/StackedBarChartSpec"
            },
            {
              "$ref": "#/$defs/PieChartSpec"
            },
            {
              "$ref": "#/$defs/TimeSeriesSpec"
            },
            {
              "$ref": "#/$defs/HistogramSpec"
            },
            {
              "$ref": "#/$defs/ScatterPlotSpec"
            },
            {
              "$ref": "#/$defs/NetworkGraphSpec"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visualization"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "status"
  ],
  "title": "VisualizationResponse",
  "type": "object"
}
