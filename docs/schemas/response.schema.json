        },
        "year_to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive last year, or null.",
          "title": "Year To"
        }
      },
      "required": [
        "date_basis",
        "year_from",
        "year_to"
      ],
      "title": "TimeScope",
