{
  "$defs": {
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "One question that resolves the ambiguity.",
          "title": "Question",
          "type": "string"
        },
        "options": {
          "description": "2-4 concrete answers the user could pick.",
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Cohort": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Short display label, e.g. 'pembrolizumab' or 'breast cancer'.",
          "title": "Label",
          "type": "string"
        },
        "filters": {
          "$ref": "#/$defs/CohortFilters"
        }
      },
      "required": [
        "label",
        "filters"
      ],
      "title": "Cohort",
      "type": "object"
    },
    "CohortFilters": {
      "additionalProperties": false,
      "properties": {
        "drug_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Drug or intervention exactly as the user named it (generic, brand or code). Do not add synonyms; the registry search expands them. Null if unconstrained.",
          "title": "Drug Name"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Condition/disease as named by the user, or null.",
          "title": "Condition"
        },
        "sponsor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lead sponsor organisation, or null.",
          "title": "Sponsor"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Country of a trial location (English name), or null.",
          "title": "Country"
        },
        "trial_phase": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Phase"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Keep trials in any of these phases, or null for all phases.",
          "title": "Trial Phase"
        },
        "overall_status": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/OverallStatus"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Keep trials with any of these statuses, or null for all statuses.",
          "title": "Overall Status"
        },
        "study_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Restrict study type, or null."
        }
      },
      "required": [
        "drug_name",
        "condition",
        "sponsor",
        "country",
        "trial_phase",
        "overall_status",
        "study_type"
      ],
      "title": "CohortFilters",
      "type": "object"
    },
    "DateBasis": {
      "enum": [
        "start_date",
        "first_posted",
        "completion_date"
      ],
      "title": "DateBasis",
      "type": "string"
    },
    "Dimension": {
      "description": "Fields a chart can group by. Each one has an entry in app.registry.",
      "enum": [
        "phase",
        "overall_status",
        "study_type",
        "lead_sponsor",
        "sponsor_class",
        "drug",
        "intervention_type",
        "condition",
        "country",
        "primary_purpose",
        "allocation",
        "site",
        "investigator"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "Measure": {
      "description": "Per-trial numeric or date values: histogram bins and scatter axes.",
      "enum": [
        "enrollment",
        "duration_months",
        "start_date"
      ],
      "title": "Measure",
      "type": "string"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "dimension": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dimension"
            },
            {
              "type": "null"
            }
          ],
          "description": "count_by: the grouping dimension. network: the first node type. scatter: optional colour category. time_trend, histogram: null."
        },
        "second_dimension": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dimension"
            },
            {
              "type": "null"
            }
          ],
          "description": "network: the second node type (same as dimension for a co-occurrence network). count_by, time_trend: optional series split, only with a single cohort. Otherwise null."
        },
        "measure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measure"
            },
            {
              "type": "null"
            }
          ],
          "description": "histogram: the value to bin. scatter: the y axis. Otherwise null."
        },
        "x_measure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measure"
            },
            {
              "type": "null"
            }
          ],
          "description": "scatter: the x axis. Otherwise null."
        }
      },
      "required": [
        "kind",
        "dimension",
        "second_dimension",
        "measure",
        "x_measure"
      ],
      "title": "Operation",
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "count_by",
        "time_trend",
        "histogram",
        "scatter",
        "network"
      ],
      "title": "OperationKind",
      "type": "string"
    },
    "OverallStatus": {
      "enum": [
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "ENROLLING_BY_INVITATION",
        "ACTIVE_NOT_RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "COMPLETED",
        "WITHDRAWN",
        "UNKNOWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "TEMPORARILY_NOT_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD"
      ],
      "title": "OverallStatus",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE2",
        "PHASE3",
        "PHASE4",
        "NA"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PhasePolicy": {
      "enum": [
        "combined",
        "split"
      ],
      "title": "PhasePolicy",
      "type": "string"
    },
    "StudyType": {
      "enum": [
        "INTERVENTIONAL",
        "OBSERVATIONAL",
        "EXPANDED_ACCESS"
      ],
      "title": "StudyType",
      "type": "string"
    },
    "TimeScope": {
      "additionalProperties": false,
      "properties": {
        "date_basis": {
          "$ref": "#/$defs/DateBasis",
          "description": "Which trial date defines 'year'. start_date unless the user asks about registration/posting (first_posted) or completion (completion_date)."
        },
        "year_from": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive first year, or null.",
          "title": "Year From"
        },
        "year_to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive last year, or null.",
          "title": "Year To"
        }
      },
      "required": [
        "date_basis",
        "year_from",
        "year_to"
      ],
      "title": "TimeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cohorts": {
      "description": "One cohort per compared group (1-4). Shared filters repeat in each cohort.",
      "items": {
        "$ref": "#/$defs/Cohort"
      },
      "title": "Cohorts",
      "type": "array"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "time": {
      "$ref": "#/$defs/TimeScope"
    },
    "phase_policy": {
      "$ref": "#/$defs/PhasePolicy",
      "description": "combined unless the user asks to count each phase of multi-phase trials."
    },
    "top_n": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Show only the N largest categories/nodes (1-100), or null for the default.",
      "title": "Top N"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set ONLY when a missing detail would materially change the answer and no sensible default exists. Otherwise null."
    },
    "unsupported_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set when the question needs data or analysis this system does not support (e.g. efficacy, adverse events, patient eligibility). Otherwise null.",
      "title": "Unsupported Reason"
    }
  },
  "required": [
    "cohorts",
    "operation",
    "time",
    "phase_policy",
    "top_n",
    "clarification",
    "unsupported_reason"
  ],
  "title": "QueryPlan",
  "type": "object"
}
